# apps/mobile/.env olarak kopyalayın (.env git'e girmez).
# EXPO_PUBLIC_ ile başlayan değişkenler uygulamanın içine gömülür; gizli
# anahtar koymayın.

# MyShelfie API (Render). Yerelde denemek için bilgisayarın yerel ağ IP'si:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# (Telefon "localhost"a bağlanamaz; o telefonun kendisi demek.)
EXPO_PUBLIC_API_URL=

# Google Books araması ve kapak bulma için (web'deki anahtarla aynı olabilir)
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
