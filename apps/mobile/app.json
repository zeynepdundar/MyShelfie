{
  "expo": {
    "name": "MyShelfie",
    "slug": "myshelfie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myshelfie",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0a09",
    "ios": {
      "bundleIdentifier": "space.myshelfie.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "space.myshelfie.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a5b6f",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "en": "./locales/app.en.json",
      "tr": "./locales/app.tr.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a5b6f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
