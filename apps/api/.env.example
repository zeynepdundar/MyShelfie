# apps/api/.env olarak kopyalayın:  cp apps/api/.env.example apps/api/.env
# Hiçbiri zorunlu değil; eksik olan bağımlılığa dokunan istek 503 döner.

PORT=4000

# Virgülle ayrılmış izinli origin'ler (web uygulaması)
CORS_ORIGIN=http://localhost:3000

# Yerel Postgres (repo kökünde: docker compose up -d)
DATABASE_URL=postgresql://shelfie:shelfie@localhost:5433/shelfie

# Firebase servis hesabı — Firebase Console › Project settings › Service accounts
# › Generate new private key. JSON'daki project_id, client_email, private_key.
# private_key tek satır, \n kaçışlarıyla ve tırnak içinde yazılır.
FIREBASE_PROJECT_ID=shelfie-7bb6c
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Yalnızca yerel geliştirme: tanımlıysa token aranmaz, bütün istekler bu
# kullanıcıya ait sayılır. NODE_ENV=production iken yok sayılır.
DEV_USER_ID=test-user
