// MyShelfie veri modeli.
//
// Kimlik Firebase Auth'ta; User.id doğrudan Firebase uid'sidir, bu yüzden
// parola/oturum tablosu yok. Kullanıcı satırı ilk istekte açılır
// (src/services/users.ts › ensureUser).
//
// Bağlantı adresi şemada değil prisma.config.ts içinde (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id
  email       String?
  displayName String?
  photoUrl    String?
  /// Misafir (anonymous) Firebase hesabı mı? Kalıcı yöntem bağlanınca false olur.
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("users")
}

model Book {
  id            String  @id @default(cuid())
  userId        String
  title         String
  author        String
  pages         Int     @default(0)
  isbn          String?
  publishedYear Int?
  genre         String?
  rating        Int?
  notes         String?
  coverUrl      String?

  // Durum kuralı (web › lib/bookStatus.ts ile aynı): bitiş tarihi olan kitap
  // okunmuştur. API yazarken bu bayrakları tutarlı hâle getirir
  // (src/services/books.ts › normalizeStatus), filtreler de buna göre çalışır.
  isCompleted Boolean @default(false)
  isFavorite  Boolean @default(false)
  wantToRead  Boolean @default(false)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  /// Eski kayıtlardan kalan alan; yeni yazmalarda endDate ile aynı tutulur.
  dateRead  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@index([userId, createdAt])
  @@map("books")
}

model Quote {
  id        String   @id @default(cuid())
  bookId    String
  text      String
  page      Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
  @@map("quotes")
}
