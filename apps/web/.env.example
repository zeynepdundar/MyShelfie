# apps/web/.env.local olarak kopyalayın (.env.local git'e girmez).

# Zorunlu: kitap verisi ve katalog araması apps/api üzerinden gelir.
# Yerelde API'nin portu (apps/api/.env › PORT) ile aynı olmalı.
NEXT_PUBLIC_API_URL=http://localhost:4000

# İsteğe bağlı: katalogda bulunamayan kitaplar için Google Books yedeği
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=
