# apps/web/.env.local olarak kopyalayın (.env.local git'e girmez).

# Google Books araması ve kapak bulma için
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Tanımlıysa kitap verisi apps/api üzerinden (Postgres) okunur/yazılır.
# Boş bırakılırsa uygulama doğrudan Firestore'u kullanır (canlı sitenin
# şu anki hâli). Yerelde API ile denemek için:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=
