rules_version = '2';

// MyShelfie verisi Postgres'te (apps/api); istemcilerin Firestore'a erişimi
// tamamen kapalı. Eski users/{uid} kayıtlarını yalnızca API (Admin SDK,
// kurallardan etkilenmez) okur ve hesap silinirken temizler.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
